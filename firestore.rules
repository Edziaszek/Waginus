rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funkcje pomocnicze ----------

    // Dostęp tylko dla zalogowanych z POTWIERDZONYM adresem e-mail
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Tylko znane kolekcje danych
    function known(c) {
      return c in ['Waga', 'Treningi', 'Cwiczenia', 'Obwody', 'Kardio', 'KardioTypy'];
    }
    function profilePath(id) {
      return /databases/$(database)/documents/profiles/$(id);
    }
    // Uwaga na limity: reguły mogą wykonać tylko ograniczoną liczbę odczytów pomocniczych (get/exists) – 10 na operację
    // i 20 na całą paczkę zapisów. Dlatego rola i status są sprawdzane JEDNYM odczytem profilu na operację
    // (profil jest przekazywany do funkcji, a nie pobierany wielokrotnie).
    function adminProfile(p) {
      return p.Rola == 'admin' && p.get('Status', 'aktywny') == 'aktywny';
    }
    // Administrator = profil z Rola == 'admin' i konto nie jest usunięte (brak profilu = nie administrator)
    function isAdmin() {
      return signedIn() && adminProfile(get(profilePath(request.auth.uid)).data);
    }
    // Konto aktywne (nie usunięte przez administratora). Profil tworzy się przy pierwszym uruchomieniu aplikacji,
    // zanim zapisane zostaną jakiekolwiek dane.
    function active() {
      return get(profilePath(request.auth.uid)).data.get('Status', 'aktywny') != 'usuniety';
    }

    // KONTA ZAŁOŻYCIELSKIE – jedyne, które mogą od razu dostać rolę administratora.
    // Wpisz UID wszystkich dotychczasowych kont (Firebase Console → Authentication → Users → kolumna "User UID").
    // Każde inne konto zakłada się jako zwykły użytkownik, a rolę zmienia mu dopiero administrator.
    function isFounder() {
      return request.auth.uid in ['WPISZ_UID_KONTA_1', 'WPISZ_UID_KONTA_2'];
    }

    function nickPath(n) {
      return /databases/$(database)/documents/nicks/$(n.lower());
    }
    // Pseudonim wpisany do profilu musi być FAKTYCZNIE zajęty przez tego użytkownika (w tej samej paczce zapisów)
    function ownsNick(n) {
      return n != '' && getAfter(nickPath(n)).data.uid == request.auth.uid;
    }

    // Poprawny kształt profilu (ogranicza pola i zakresy – nikt nie wpisze śmieci)
    function validProfile(d) {
      return d.keys().hasOnly(['Email', 'Rola', 'Status', 'Wzrost', 'RokUrodzenia', 'Plec', 'Utworzono', 'SekcjeKolejnosc', 'SekcjeUkryte',
                              'Motyw', 'AkcentJasny', 'AkcentCiemny',
                              'SortCwiczenia', 'SortKardio', 'SortObwody',
                              'Pseudonim', 'ProfilPubliczny'])
        && d.Rola in ['admin', 'user']
        && d.get('Status', 'aktywny') in ['aktywny', 'usuniety']
        && (d.get('Wzrost', null) == null || (d.Wzrost is number && d.Wzrost >= 100 && d.Wzrost <= 250))
        && (d.get('RokUrodzenia', null) == null || (d.RokUrodzenia is int && d.RokUrodzenia >= 1900 && d.RokUrodzenia <= 2100))
        && d.get('Plec', '') in ['', 'M', 'K', 'I']
        // układ strony głównej: listy id sekcji (ograniczona długość)
        && d.get('SekcjeKolejnosc', []) is list && d.get('SekcjeKolejnosc', []).size() <= 12
        && d.get('SekcjeUkryte', []) is list && d.get('SekcjeUkryte', []).size() <= 12
        // wygląd: motyw i identyfikatory kolorów akcentu
        && d.get('Motyw', 'light') in ['light', 'dark']
        && d.get('AkcentJasny', '') is string && d.get('AkcentJasny', '').size() <= 20
        && d.get('AkcentCiemny', '') is string && d.get('AkcentCiemny', '').size() <= 20
        // kolejność list: az / za / new / old / recent / freq
        && d.get('SortCwiczenia', 'az') in ['az', 'za', 'new', 'old', 'recent', 'freq']
        && d.get('SortKardio', 'az') in ['az', 'za', 'new', 'old', 'recent', 'freq']
        && d.get('SortObwody', 'az') in ['az', 'za', 'new', 'old', 'recent', 'freq']
        // pseudonim (opcjonalny): 3–20 znaków a–z, A–Z, 0–9, _ i -
        && d.get('Pseudonim', '').matches('^([A-Za-z0-9_-]{3,20})?$')
        && d.get('ProfilPubliczny', false) is bool;
    }

    // ---------- profile: profiles/{uid} ----------
    match /profiles/{uid} {
      // własny profil widzi właściciel; wszystkie – administrator
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Utworzenie własnego profilu: e-mail musi zgadzać się z kontem, a rola 'admin' tylko dla kont założycielskich
      allow create: if signedIn() && request.auth.uid == uid
                    && validProfile(request.resource.data)
                    && request.resource.data.Email == request.auth.token.email
                    && request.resource.data.get('Status', 'aktywny') == 'aktywny'
                    && (request.resource.data.Rola == 'user' || isFounder());

      // Zmiana: administrator może wszystko (rola, status, dane); zwykły użytkownik tylko swoje dane,
      // bez ruszania roli, statusu i e-maila
      allow update: if signedIn() && validProfile(request.resource.data) && (
                      isAdmin()
                      || (request.auth.uid == uid && active()
                          && request.resource.data.Rola == resource.data.Rola
                          && request.resource.data.Email == resource.data.Email
                          && request.resource.data.get('Status', 'aktywny') == resource.data.get('Status', 'aktywny')
                          && (request.resource.data.get('Pseudonim', '') == resource.data.get('Pseudonim', '')
                              || ownsNick(request.resource.data.get('Pseudonim', ''))))
                    );
      // usuwanie profili jest zablokowane – "usunięcie" użytkownika to Status == 'usuniety'
    }

    // ---------- dane użytkownika: users/{uid}/{kolekcja}/{dokument} ----------
    match /users/{uid}/{coll}/{docId} {
      // Odczyt i usuwanie: właściciel (jeśli konto aktywne) albo administrator.
      // Administrator potrzebuje tego wyłącznie do wyczyszczenia danych usuwanego użytkownika.
      allow read, delete: if signedIn() && known(coll)
                          && ((request.auth.uid == uid && active()) || isAdmin());

      // Zapis tylko do własnego folderu i tylko dla aktywnego konta
      allow create, update: if signedIn() && known(coll)
                            && request.auth.uid == uid && active()
                            && request.resource.data.size() <= 15;
    }

    // ---------- pseudonimy: nicks/{pseudonim_małymi_literami} = { uid } ----------
    // Dokument można UTWORZYĆ tylko raz, więc dwie osoby nie zajmą tego samego pseudonimu (nawet równocześnie).
    // Odczyt tylko pojedynczego dokumentu (sprawdzenie dostępności i adres profilu) – bez wylistowania wszystkich pseudonimów.
    match /nicks/{nick} {
      allow get: if true;
      allow create: if signedIn() && active()
                    && nick.matches('^[a-z0-9_-]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(profilePath(request.auth.uid)).data.get('Pseudonim', '').lower() == nick;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());   // zmiana pseudonimu zwalnia stary
    }

    // ---------- profil publiczny: publicProfiles/{uid} (ustawienia) i /data/* (udostępniana treść) ----------
    // Czyta KTOKOLWIEK (także bez konta) – dlatego trafia tu wyłącznie to, co właściciel świadomie udostępnił.
    // Dane prywatne (users/...) pozostają niedostępne. Zapisuje wyłącznie właściciel.
    function validPublic(d) {
      return d.keys().hasOnly(['Nick', 'Plec', 'Utworzono', 'Zaktualizowano', 'Ustawienia', 'H', 'HM'])
        && d.Nick is string && d.Nick.size() >= 3 && d.Nick.size() <= 20
        && d.get('Plec', '') in ['', 'M', 'K', 'I'];
    }
    match /publicProfiles/{uid} {
      allow get: if true;   // bez list – nie da się wylistować wszystkich profili
      allow create, update: if signedIn() && request.auth.uid == uid && active()
                            && validPublic(request.resource.data)
                            && request.resource.data.Nick == get(profilePath(uid)).data.get('Pseudonim', '');
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());

      match /data/{docId} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == uid && active()
                              && request.resource.data.size() <= 10;
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    // Wszystko inne jest domyślnie zablokowane.
  }
}
