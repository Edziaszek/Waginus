rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dostęp tylko dla zalogowanych z POTWIERDZONYM adresem e-mail
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Tylko znane kolekcje – nikt nie założy własnych, śmieciowych
    function known(c) {
      return c in ['Waga', 'Treningi', 'Cwiczenia', 'Obwody', 'Kardio', 'KardioTypy'];
    }

    // Dane użytkownika: każdy widzi i zmienia wyłącznie własny folder users/{jego uid}/...
    match /users/{uid}/{coll}/{docId} {
      allow read, delete: if verified() && request.auth.uid == uid && known(coll);
      allow create, update: if verified() && request.auth.uid == uid && known(coll)
                            && request.resource.data.size() <= 15;   // ogranicza rozdmuchiwanie dokumentów
    }

    // TYMCZASOWE – tylko do jednorazowego importu starych danych (sprzed kont).
    // Wpisz swoje UID (Ustawienia → Ogólne → Konto). Po imporcie USUŃ ten blok!
    match /{legacy}/{docId} {
      allow read: if verified() && request.auth.uid == 'WPISZ_TUTAJ_SWOJE_UID' && known(legacy);
    }

    // Wszystko inne jest domyślnie zablokowane.
  }
}
